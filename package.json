{
  "name": "masen-map",
  "version": "0.18.0",
  "description": "Generate standalone, CSS-themeable SVG maps from a region and a stylesheet.",
  "keywords": [
    "map",
    "svg",
    "cartography",
    "geojson",
    "topojson",
    "natural-earth",
    "projection",
    "d3-geo",
    "choropleth",
    "static-maps"
  ],
  "author": {
    "name": "Daniele Frisanco",
    "url": "https://danielefrisanco.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielefrisanco/masen.git"
  },
  "homepage": "https://danielefrisanco.github.io/masen/",
  "bugs": {
    "url": "https://github.com/danielefrisanco/masen/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./themes/*.css": "./themes/*.css",
    "./palettes/*.css": "./palettes/*.css",
    "./typefaces/*.css": "./typefaces/*.css",
    "./package.json": "./package.json"
  },
  "browser": {
    "node:fs/promises": false
  },
  "files": [
    "dist",
    "themes",
    "palettes",
    "typefaces",
    "data"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-stylesheets.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tool.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "check": "npm run build:data && npm run typecheck && npm run test && npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check",
    "build:data": "node scripts/build-data.mjs",
    "fetch:data": "node scripts/fetch-natural-earth.mjs",
    "tool:dev": "vite",
    "tool:build": "vite build && npm run gallery -- tool/dist/gallery.html && node scripts/verify-tool.mjs",
    "tool:preview": "vite preview",
    "gallery": "node scripts/build-gallery.mjs",
    "demo": "node scripts/record-demo.mjs",
    "demo:social": "DEMO_CUT=social node scripts/record-demo.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@mapbox/maki": "^8.2.0",
    "@rapideditor/temaki": "^5.13.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.12.0",
    "sane-topojson": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
