node_modules/
*.tsbuildinfo
.DS_Store

# Build output, all of it at the repository root.
#
# These need the leading slash. Without it, `themes/` matches a directory of
# that name at ANY depth — including `src/themes/`, which is where the themes
# are actually written. That is how five themes, four palettes and five
# typefaces stayed out of the repository entirely: they were on disk, they
# built locally, and `git add -A` silently skipped them every time.
/dist/
/coverage/
/themes/
/palettes/
/typefaces/
/data/

# The gallery contact sheet, built by `npm run gallery`. Every committed
# snapshot inlined on one page — three megabytes of SVG, which is a diff nobody
# can read, so it is generated on demand rather than tracked. The snapshots it
# is built from are the tracked thing.
/gallery.html

# The build plan — the single source for the roadmap, kept beside the code so
# it is not forgotten. Open it in a browser, or read the published copy at
# https://claude.ai/code/artifact/1ad97eac-6e9c-4944-96fb-3e6530d9e83d
#
# Untracked on purpose: the published page is canonical, and a 75 KB single-file
# HTML page in git produces a diff nobody can read. There is deliberately no
# second Markdown copy — two plans drift.
masen-plan.html

# Reference images — maps someone else drew, kept beside the tests as a target
# for what to build next. Not ours to redistribute, and not inputs to any test.
#
# Anchored with the path, not a leading slash: `/ideas/` would mean a directory
# called `ideas` at the repository root, which is not where these are.
test/ideas/

# The tool's build output. Same bargain as dist/ — generated, deployed by
# an action, never committed.
/tool/dist/

# The screencast frames, between capture and encode. `npm run demo` removes
# them itself; this is here for the run that does not get that far.
/.demo-frames/
